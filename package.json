{
	"name": "cno-plugin-cnhsa-content-federation",
	"version": "2.0.0",
	"description": "The plugin for CNHSA content federation.",
	"author": "Choctaw Nation of Oklahoma",
	"license": "GPL-3.0-or-later",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"files": [
		"inc/",
		"cno-plugin-cnhsa-content-federation.php",
		"README.md",
		"build/",
		"LICENSE",
		"vendor/"
	],
	"engines": {
		"node": ">= 24",
		"npm": ">= 12"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"core-js@3.49.0": true,
		"core-js-pure@3.49.0": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"unrs-resolver@1.12.2": true
	},
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@eslint/compat": "^2",
		"@wordpress/api-fetch": "^7.51.0",
		"@wordpress/base-styles": "^11.0.0",
		"@wordpress/components": "^37.0.0",
		"@wordpress/dom-ready": "^4.51.0",
		"@wordpress/element": "^8.3.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/scripts": "^33.0.0",
		"eslint": "^9",
		"globals": "^17",
		"prettier": "npm:wp-prettier@^3",
		"stylelint": "^17",
		"stylelint-config-standard-scss": "^17",
		"stylelint-scss": "^7"
	}
}
